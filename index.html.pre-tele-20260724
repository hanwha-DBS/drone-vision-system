        // ============ Geo tags (estimated coordinates) — DEMO overlay ============
        // Pure front-end, additive. Uses ASSUMED telemetry (no real drone GPS yet).
        // When SRT / live telemetry is wired in, replace GEO_TELEMETRY with parsed values.
        const GEO_TELEMETRY = {
            droneLat: 37.283420,   // 드론 위도 (가정) — 실제 시연 현장 좌표로 교체
            droneLon: 127.108650,  // 드론 경도 (가정) — 실제 시연 현장 좌표로 교체
            aglMeters: 25,         // 지면 위 고도 AGL (실측: 지표면 25m)
            groundAltMeters: 25,   // 지면 해발표고 (가정) — 대상 고도 표기용, 현장 표고로 교체 가능
            headingDeg: 15,        // 기수 방위 (북=0, 시계방향)
            gimbalPitchDeg: -30,   // 짐벌 pitch (실측: -30°, 비스듬히 전방·하방)
            vFovDeg: 55,           // 카메라 수직 화각(도)
        };
        const geoTableBody = document.getElementById('geoTableBody');
        const geoToggle = document.getElementById('geoToggle');

        // Monoplotting: back-project a ground-contact pixel to a lat/lon on flat ground.
        function pixelToLatLon(px, py, imgW, imgH, t) {
            const d2r = Math.PI / 180;
            const vFov = t.vFovDeg * d2r;
            const hFov = 2 * Math.atan(Math.tan(vFov / 2) * (imgW / imgH));
            const u = (px - imgW / 2) / (imgW / 2);   // right +
            const v = (py - imgH / 2) / (imgH / 2);   // down +
            const dx = u * Math.tan(hFov / 2);
            const dy = v * Math.tan(vFov / 2);
            const th = t.headingDeg * d2r, ph = t.gimbalPitchDeg * d2r;
            const cph = Math.cos(ph), sph = Math.sin(ph);
            const cth = Math.cos(th), sth = Math.sin(th);
            // Camera basis in ENU (x=East, y=North, z=Up).
            const f = [sth * cph, cth * cph, sph];   // forward (optical axis)
            const r = [cth, -sth, 0];                // right
            const dd = [                             // down = forward × right
                f[1] * r[2] - f[2] * r[1],
                f[2] * r[0] - f[0] * r[2],
                f[0] * r[1] - f[1] * r[0],
            ];
            const ray = [
                f[0] + dx * r[0] + dy * dd[0],
                f[1] + dx * r[1] + dy * dd[1],
                f[2] + dx * r[2] + dy * dd[2],
            ];
            if (ray[2] >= -1e-4) return null;        // at/above horizon → no ground hit
            const dist = t.aglMeters / (-ray[2]);
            const east = ray[0] * dist, north = ray[1] * dist;
            const lat = t.droneLat + north / 111320;
            const lon = t.droneLon + east / (111320 * Math.cos(t.droneLat * d2r));
            return { lat, lon, alt: t.groundAltMeters };
        }

        function renderGeoTags(detections) {
            if (!geoTableBody) return;
            const on = !geoToggle || geoToggle.checked;
            const card = geoTableBody.closest('.geo-card');
            if (card) card.style.display = on ? '' : 'none';
            if (!on) return;
            const dets = Array.isArray(detections) ? detections : [];
            if (!dets.length) {
                geoTableBody.innerHTML = '<tr><td colspan="6"><div class="geo-empty">탐지된 대상이 없습니다.</div></td></tr>';
                return;
            }
            const imgW = analysisImage.naturalWidth || 1920;
            const imgH = analysisImage.naturalHeight || 1080;
            geoTableBody.innerHTML = dets.map((d, i) => {
                const px = (Number(d.x1) + Number(d.x2)) / 2;
                const py = Number(d.y2); // bottom-center = ground contact
                const geo = pixelToLatLon(px, py, imgW, imgH, GEO_TELEMETRY);
                const isPerson = d.label === 'person';
                const kls = isPerson ? 'person' : 'vehicle';
                const kor = isPerson ? '사람' : '차량';
                const score = d.score != null ? `${Math.round(Number(d.score) * 100)}%` : '—';
                const coords = geo
                    ? `<td class="geo-coord">${geo.lat.toFixed(6)}</td><td class="geo-coord">${geo.lon.toFixed(6)}</td><td class="geo-coord">${geo.alt.toFixed(0)}</td>`
                    : `<td class="geo-coord" colspan="3">지평선 부근 · 산출 불가</td>`;
                return `<tr><td>${i + 1}</td><td><span class="geo-cls"><span class="geo-dot ${kls}"></span>${kor}</span></td><td>${score}</td>${coords}</tr>`;
            }).join('');
        }

