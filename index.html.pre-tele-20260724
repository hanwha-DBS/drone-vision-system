<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Hanwha · Drone Detection System</title>
    <style>
        /* Bundled locally so the desktop app renders correctly offline. */
        @font-face {
            font-family: "Pretendard Variable";
            src: url("Resources/fonts/PretendardVariable.woff2") format("woff2-variations");
            font-weight: 45 920;
            font-display: swap;
        }

        :root {
            /* Muted light base — toned down from pure white to reduce glare. */
            --bg-base: #d9dee6;
            --bg-elev: #eef1f5;
            --bg-card: #f1f3f7;
            --bg-soft: rgba(20, 28, 40, 0.05);
            --bg-softer: rgba(20, 28, 40, 0.08);
            --border: rgba(20, 28, 40, 0.13);
            --border-soft: rgba(20, 28, 40, 0.09);
            --border-strong: rgba(20, 28, 40, 0.20);
            --text: #1b2330;
            --text-2: #47546a;
            --muted: #6f7b89;
            --muted-2: #93a0ad;

            /* Darkened accent text variants — legible on light surfaces. */
            --on-safe: #1f8a5b;
            --on-danger: #c5303b;
            --on-warn: #b5531a;
            --on-notice: #8a6a12;
            --on-brand: #c2580f;

            /* Brand: Hanwha orange — the single disciplined accent. */
            --brand: #f37321;
            --brand-strong: #ff8a3d;
            --brand-weak: rgba(243, 115, 33, 0.14);
            --accent: #f37321;
            --accent-2: #ff8a3d;
            --primary: #f37321;
            --primary-2: #ff8a3d;

            /* Semantic risk colors (kept distinct from the brand orange). */
            --danger: #ff5a5f;
            --danger-2: #ff8696;
            --warn: #ff9f45;
            --notice: #ffd15c;
            --safe: #3fb37f;

            --shadow-card: 0 1px 2px rgba(20, 28, 40, 0.06), 0 8px 24px rgba(20, 28, 40, 0.07);
            --radius-lg: 18px;
            --radius-md: 12px;
            --radius-sm: 8px;

            /* Type scale */
            --text-xs: 11px;
            --text-sm: 12px;
            --text-base: 14px;
            --text-lg: 16px;
            --text-xl: 20px;

            /* Spacing scale (4px grid) */
            --space-1: 4px;
            --space-2: 8px;
            --space-3: 12px;
            --space-4: 16px;
            --space-5: 24px;
            --space-6: 32px;

            --ring: 0 0 0 3px rgba(243, 115, 33, 0.45);
        }

        * { box-sizing: border-box; }

        html, body { height: 100%; }

        body {
            margin: 0;
            color: var(--text);
            font-family: "Pretendard Variable", "Pretendard", -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif;
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
            background:
                radial-gradient(circle at 88% -10%, rgba(243, 115, 33, 0.06), transparent 24%),
                radial-gradient(circle at 5% 0%, rgba(243, 115, 33, 0.035), transparent 26%),
                linear-gradient(180deg, #e3e8ee 0%, var(--bg-base) 60%);
            overflow: hidden;
        }

        /* ============ Shell ============ */
        .shell {
            display: grid;
            grid-template-columns: 232px 1fr;
            grid-template-rows: 64px 1fr;
            height: 100vh;
        }

        /* ============ Topbar ============ */
        .topbar {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 0 22px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(180deg, rgba(237, 240, 245, 0.94), rgba(228, 232, 238, 0.94));
            backdrop-filter: blur(12px);
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 200px;
            padding-right: 18px;
            height: 100%;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: #ffffff;
            display: grid;
            place-items: center;
            box-shadow: 0 6px 18px rgba(243, 115, 33, 0.32);
            overflow: hidden;
        }

        .brand-logo-img {
            width: 36px;
            height: 36px;
            object-fit: contain;
        }

        .brand-name {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 0.01em;
            line-height: 1.05;
            color: var(--brand);
        }

        .brand-sub {
            font-size: 10.5px;
            color: var(--text-2);
            letter-spacing: 0.26em;
            text-transform: uppercase;
            font-weight: 600;
            margin-top: 3px;
        }

        .site-selector {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 12px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            min-width: 280px;
        }

        .site-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--safe);
            box-shadow: 0 0 0 4px rgba(46, 207, 141, 0.18);
            animation: pulse-soft 2.4s ease-in-out infinite;
        }

        @keyframes pulse-soft {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.55; }
        }

        .site-name {
            font-size: 13px;
            font-weight: 600;
        }

        .site-meta {
            font-size: 11px;
            color: var(--muted);
        }

        .status-cluster {
            display: flex;
            flex-wrap: nowrap;
            gap: 8px;
            margin-left: auto;
        }

        .led-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border-radius: 999px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            font-size: 12px;
            color: var(--text-2);
            white-space: nowrap;
        }

        .led {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--muted-2);
        }

        .led.on { background: var(--safe); box-shadow: 0 0 0 3px rgba(46, 207, 141, 0.18); }
        .led.warn { background: var(--warn); box-shadow: 0 0 0 3px rgba(255, 176, 86, 0.18); }
        .led.err { background: var(--danger); box-shadow: 0 0 0 3px rgba(255, 85, 107, 0.18); animation: pulse-soft 1.4s ease-in-out infinite; }

        .led-pill.ready { color: var(--on-safe); border-color: rgba(63, 179, 127, 0.45); background: rgba(63, 179, 127, 0.12); }
        .led-pill.error { color: var(--on-danger); border-color: rgba(255, 90, 95, 0.45); background: rgba(255, 90, 95, 0.12); }

        .risk-badge {
            font-weight: 800;
            letter-spacing: 0.06em;
        }

        .risk-clear { color: var(--on-safe); border-color: rgba(63, 179, 127, 0.40); background: rgba(63, 179, 127, 0.12); }
        .risk-notice { color: var(--on-notice); border-color: rgba(255, 209, 92, 0.45); background: rgba(255, 209, 92, 0.16); }
        .risk-warning { color: var(--on-warn); border-color: rgba(255, 159, 69, 0.45); background: rgba(255, 159, 69, 0.14); }
        .risk-critical { color: var(--on-danger); border-color: rgba(255, 90, 95, 0.45); background: rgba(255, 90, 95, 0.13); animation: pulse-soft 1.2s ease-in-out infinite; }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px 6px 6px;
            border-radius: 999px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
        }

        .avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f37321, #ff8a3d);
            display: grid;
            place-items: center;
            font-size: 11px;
            font-weight: 800;
            color: #04110b;
        }

        .user-name { font-size: 12px; font-weight: 600; }
        .user-sub { font-size: 10px; color: var(--muted); letter-spacing: 0.04em; }

        /* ============ Sidebar ============ */
        .sidebar {
            border-right: 1px solid var(--border);
            padding: 18px 14px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            background: rgba(237, 240, 245, 0.6);
            overflow-y: auto;
        }

        .nav-group-label {
            font-size: 10px;
            color: var(--muted);
            letter-spacing: 0.16em;
            text-transform: uppercase;
            padding: 0 10px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            margin-bottom: 4px;
            border-radius: 10px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-2);
            font-size: 13px;
            cursor: pointer;
            width: 100%;
            text-align: left;
            transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
        }

        .nav-item:hover {
            background: var(--bg-soft);
            color: var(--text);
        }

        .nav-item.active {
            background: rgba(243, 115, 33, 0.12);
            border-color: rgba(243, 115, 33, 0.34);
            color: var(--on-brand);
            font-weight: 600;
        }

        .nav-item svg { width: 18px; height: 18px; flex-shrink: 0; opacity: 0.85; }

        .nav-item .nav-tag {
            margin-left: auto;
            font-size: 10px;
            color: var(--muted);
            padding: 2px 7px;
            border-radius: 999px;
            background: var(--bg-softer);
        }

        .sidebar-foot {
            font-size: 10px;
            color: var(--muted-2);
            text-align: center;
            padding-top: 6px;
            border-top: 1px solid var(--border-soft);
            letter-spacing: 0.05em;
        }

        /* ============ Content ============ */
        .content {
            overflow-y: auto;
            padding: 18px 22px 28px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .content::-webkit-scrollbar { width: 10px; }
        .content::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.10); border-radius: 999px; }

        /* ============ Views (IA) ============ */
        .view { display: none; flex-direction: column; gap: 16px; min-width: 0; }
        .view.active { display: flex; animation: viewIn 0.22s ease; }
        @keyframes viewIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

        .view-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            padding: 2px 2px 6px;
            border-bottom: 1px solid var(--border-soft);
        }
        .view-title { font-size: 20px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
        .view-desc { font-size: 12px; color: var(--muted); margin-top: 3px; }
        .view-header-meta { display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--muted); }
        .view-clock { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text-2); letter-spacing: 0.04em; }
        .view-header-meta .led { width: 7px; height: 7px; border-radius: 50%; background: var(--safe); box-shadow: 0 0 6px var(--safe); display: inline-block; margin-right: 5px; }

        /* ============ Dashboard ============ */
        .dash-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; }
        .dash-hero-main { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 24px 26px; }
        .dash-hero-eyebrow { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
        .dash-risk-big { font-size: 42px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; color: var(--on-safe); }
        .dash-risk-big.risk-clear { color: var(--on-safe); }
        .dash-risk-big.risk-notice { color: var(--on-notice); }
        .dash-risk-big.risk-warning { color: var(--on-warn); }
        .dash-risk-big.risk-critical { color: var(--on-danger); }
        .dash-hero-sub { font-size: 13px; color: var(--text-2); }
        .dash-hero-side { display: flex; flex-direction: column; justify-content: center; gap: 11px; padding: 20px 24px; }
        .dash-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--muted); }
        .dash-line b { color: var(--text); font-weight: 600; text-align: right; }
        .dash-kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
        .dash-actions { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
        .dash-actions-btns { display: flex; gap: 10px; flex-wrap: wrap; }

        @media (max-width: 1100px) {
            .dash-hero { grid-template-columns: 1fr; }
            .dash-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        /* ============ Geo tags (estimated) ============ */
        .geo-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-2); cursor: pointer; user-select: none; }
        .geo-toggle input { accent-color: var(--brand); }
        .geo-note { font-size: 11px; color: var(--muted); margin: -4px 0 10px; display: flex; align-items: center; gap: 6px; }
        .geo-note .badge-est { font-size: 9px; letter-spacing: 0.1em; padding: 2px 6px; border-radius: 999px; background: var(--brand-weak); color: var(--on-brand); font-weight: 700; }
        .geo-table-wrap { overflow: auto; max-height: 240px; }
        table.geo-table { width: 100%; border-collapse: collapse; font-size: 12px; font-variant-numeric: tabular-nums; }
        .geo-table th { text-align: left; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--bg-card); }
        .geo-table td { padding: 6px 8px; border-bottom: 1px solid var(--border-soft); color: var(--text); white-space: nowrap; }
        .geo-table tr:last-child td { border-bottom: none; }
        .geo-cls { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
        .geo-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .geo-dot.person { background: var(--brand); }
        .geo-dot.vehicle { background: var(--warn); }
        .geo-empty { color: var(--muted); font-size: 12px; padding: 10px 4px; text-align: center; }
        .geo-coord { color: var(--text-2); }

        /* ============ Mission Bar ============ */
        .mission-bar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 18px;
            align-items: center;
            padding: 14px 18px;
            border-radius: var(--radius-lg);
            background: var(--bg-card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
        }

        .mission-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .mission-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .mission-state {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            background: var(--bg-soft);
            color: var(--muted);
            border: 1px solid var(--border-soft);
        }

        .mission-state.idle { color: var(--muted); }
        .mission-state.active {
            color: var(--on-safe);
            background: rgba(63, 179, 127, 0.14);
            border-color: rgba(63, 179, 127, 0.40);
        }
        .mission-state.active .led { background: var(--safe); animation: pulse-soft 1.6s ease-in-out infinite; }
        .mission-state.stopped { color: var(--on-danger); background: rgba(255, 90, 95, 0.12); border-color: rgba(255, 90, 95, 0.38); }
        .mission-state.completed { color: var(--on-brand); background: rgba(243, 115, 33, 0.12); border-color: rgba(243, 115, 33, 0.38); }

        .mission-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            color: var(--text-2);
            font-size: 12px;
        }

        .mission-meta span b {
            color: var(--text);
            font-weight: 600;
            margin-left: 4px;
        }

        .mission-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .ctl-group {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            border-radius: 12px;
        }

        .ctl-group label {
            font-size: 11px;
            color: var(--muted);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .ctl-group input[type="range"] { width: 140px; accent-color: var(--accent); }

        .ctl-group select {
            background: var(--bg-soft);
            color: var(--text);
            border: 1px solid var(--border-soft);
            border-radius: 8px;
            padding: 5px 8px;
            font-size: 12px;
            font-family: inherit;
        }

        .ctl-value { color: var(--accent); font-weight: 700; min-width: 32px; text-align: right; font-size: 13px; }

        .mode-toggle {
            display: inline-flex;
            padding: 3px;
            border-radius: 11px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
        }

        .mode-opt {
            padding: 8px 14px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            color: var(--muted);
            background: transparent;
            border: none;
            border-radius: 8px;
            font-family: inherit;
        }

        .mode-opt.active {
            background: rgba(243, 115, 33, 0.14);
            color: var(--accent);
        }

        .watch-row {
            display: none;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            margin-top: 10px;
            border-radius: 12px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            font-size: 12px;
            color: var(--text-2);
            flex-wrap: wrap;
        }

        .watch-row.show { display: flex; }

        .stream-url-input {
            flex: 1;
            min-width: 240px;
            padding: 8px 12px;
            border-radius: 8px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            color: var(--text-1);
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 12px;
        }

        .stream-url-input::placeholder { color: var(--muted); }

        .stream-url-input:focus {
            outline: none;
            border-color: var(--accent);
            background: rgba(243, 115, 33, 0.06);
        }

        .watch-folder-path {
            font-family: 'Consolas', 'Courier New', monospace;
            color: var(--accent);
            background: rgba(243, 115, 33, 0.06);
            padding: 4px 10px;
            border-radius: 6px;
            word-break: break-all;
            min-width: 200px;
            flex: 1;
            font-size: 11px;
        }

        .watch-folder-path.empty {
            color: var(--muted);
            background: var(--bg-softer);
            font-style: italic;
        }

        .watch-status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--muted-2);
            flex-shrink: 0;
        }

        .watch-status-dot.on {
            background: var(--safe);
            box-shadow: 0 0 0 3px rgba(46, 207, 141, 0.18);
            animation: pulse-soft 2s ease-in-out infinite;
        }

        .queue-badge {
            padding: 4px 10px;
            border-radius: 999px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            font-size: 11px;
            color: var(--text-2);
            white-space: nowrap;
        }

        .queue-badge.has-items {
            background: rgba(243, 115, 33, 0.10);
            border-color: rgba(243, 115, 33, 0.30);
            color: var(--accent);
        }

        .watch-last {
            font-size: 11px;
            color: var(--muted);
            margin-left: auto;
            max-width: 240px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        button {
            border: none;
            cursor: pointer;
            font-family: inherit;
            font-weight: 700;
            transition: transform 0.16s ease, opacity 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        button:hover:not(:disabled) { transform: translateY(-1px); }
        button:disabled { opacity: 0.45; cursor: not-allowed; }

        .btn-primary {
            padding: 11px 18px;
            border-radius: 11px;
            color: #1a0e04;
            font-size: 13px;
            background: linear-gradient(135deg, #f37321, #ff8a3d);
            box-shadow: 0 8px 18px rgba(243, 115, 33, 0.26);
        }

        .btn-danger {
            padding: 11px 18px;
            border-radius: 11px;
            color: white;
            font-size: 13px;
            background: linear-gradient(135deg, #a73642, #ff556b);
            box-shadow: 0 8px 18px rgba(255, 85, 107, 0.18);
        }

        .btn-ghost {
            padding: 9px 14px;
            border-radius: 10px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            color: var(--text);
            font-size: 12px;
        }

        .btn-ghost:hover:not(:disabled) {
            background: rgba(243, 115, 33, 0.10);
            border-color: rgba(243, 115, 33, 0.30);
        }

        /* ============ KPI Strip ============ */
        .kpi-strip {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 12px;
        }

        .kpi-card {
            padding: 14px 16px;
            border-radius: var(--radius-lg);
            background: var(--bg-card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(243, 115, 33, 0.06), transparent 50%);
            pointer-events: none;
        }

        .kpi-card.accent::before { background: linear-gradient(135deg, rgba(46, 207, 141, 0.10), transparent 50%); }
        .kpi-card.warn::before { background: linear-gradient(135deg, rgba(255, 176, 86, 0.10), transparent 50%); }
        .kpi-card.danger::before { background: linear-gradient(135deg, rgba(255, 85, 107, 0.10), transparent 50%); }

        .kpi-label {
            font-size: 10px;
            color: var(--muted);
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 6px;
            position: relative;
        }

        .kpi-value {
            font-size: 26px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            line-height: 1;
            position: relative;
        }

        .kpi-value.small { font-size: 20px; }

        .kpi-foot {
            margin-top: 6px;
            font-size: 11px;
            color: var(--muted);
            letter-spacing: 0.06em;
            position: relative;
        }

        /* ============ Ops Grid ============ */
        .ops-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(360px, 0.85fr);
            gap: 16px;
        }

        .card {
            padding: 16px;
            border-radius: var(--radius-lg);
            background: var(--bg-card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
        }

        .card-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .card-title {
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-sub {
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
        }

        .card-tags {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tag {
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            color: var(--text-2);
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            white-space: nowrap;
        }

        /* ============ Viewer ============ */
        .viewer-card { display: flex; flex-direction: column; gap: 12px; }

        .viewer-stage {
            position: relative;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: #02060a;
            border: 1px solid rgba(255, 255, 255, 0.06);
            min-height: 440px;
        }

        #liveVideo,
        #liveStreamImg {
            display: block;
            width: 100%;
            max-height: 540px;
            object-fit: contain;
            background: #02060a;
        }

        .viewer-hud {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 14px;
            pointer-events: none;
        }

        .hud-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 12px;
        }

        .hud-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(8, 12, 17, 0.62);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            font-weight: 600;
            color: rgba(236, 242, 248, 0.92); /* light — sits on the dark video stage */
            letter-spacing: 0.05em;
        }

        .rec-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--danger);
            box-shadow: 0 0 0 4px rgba(255, 85, 107, 0.20);
            animation: pulse-soft 1.4s ease-in-out infinite;
        }

        .rec-dot.idle { background: var(--muted-2); box-shadow: none; animation: none; }

        .hud-corner-tl, .hud-corner-tr, .hud-corner-bl, .hud-corner-br {
            position: absolute;
            width: 22px;
            height: 22px;
            border-color: rgba(243, 115, 33, 0.55);
            border-style: solid;
        }
        .hud-corner-tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; }
        .hud-corner-tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
        .hud-corner-bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; }
        .hud-corner-br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; }

        .hud-risk-banner {
            align-self: flex-start;
            padding: 7px 14px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            background: rgba(46, 207, 141, 0.16);
            color: #c7ffe6;
            border: 1px solid rgba(46, 207, 141, 0.38);
            backdrop-filter: blur(8px);
        }

        .hud-risk-banner.risk-notice { background: rgba(255, 225, 136, 0.16); color: #ffe9a8; border-color: rgba(255, 225, 136, 0.40); }
        .hud-risk-banner.risk-warning { background: rgba(255, 176, 86, 0.16); color: #ffd3bf; border-color: rgba(255, 176, 86, 0.42); }
        .hud-risk-banner.risk-critical { background: rgba(255, 85, 107, 0.16); color: #ffd1d7; border-color: rgba(255, 85, 107, 0.42); }

        .progress-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .progress-row .progress-label {
            font-size: 12px;
            color: var(--muted);
            min-width: 90px;
        }

        .progress-bar {
            position: relative;
            flex: 1;
            height: 8px;
            background: var(--bg-softer);
            border-radius: 999px;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            border-radius: 999px;
            background: linear-gradient(90deg, #f37321, #ff8a3d);
            transition: width 0.18s linear;
        }

        /* Seekable scrubber (manual file playback only). */
        .progress-bar.seekable { cursor: pointer; }
        .progress-knob {
            position: absolute;
            top: 50%;
            left: 0%;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--brand);
            border: 2px solid #fff;
            box-shadow: 0 1px 5px rgba(20, 28, 40, 0.4);
            transform: translate(-50%, -50%);
            display: none;
        }
        .progress-bar.seekable .progress-knob { display: block; }
        .progress-bar.seekable:hover .progress-fill,
        .progress-bar.seeking .progress-fill { transition: none; }

        .pause-btn {
            width: 30px;
            height: 30px;
            flex: none;
            padding: 0;
            border-radius: 8px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            color: var(--text-2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .pause-btn:hover:not(:disabled) { color: var(--brand); border-color: var(--brand); }
        .pause-btn:disabled { opacity: 0.4; }

        .progress-percent {
            font-variant-numeric: tabular-nums;
            font-weight: 700;
            min-width: 44px;
            text-align: right;
            color: var(--accent);
        }

        .status-line {
            color: var(--text-2);
            font-size: 13px;
            line-height: 1.55;
            padding: 10px 12px;
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            border-radius: 10px;
        }

        .status-line .accent { color: var(--accent); font-weight: 700; }

        /* ============ Right Rail ============ */
        .rail {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .snapshot-head-actions { display: inline-flex; align-items: center; gap: 8px; }

        .tab-group {
            display: inline-flex;
            background: var(--bg-soft);
            padding: 3px;
            border-radius: 10px;
            border: 1px solid var(--border-soft);
        }

        .tab {
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.06em;
            color: var(--muted);
            background: transparent;
            border-radius: 8px;
            border: none;
        }

        .tab.active {
            background: rgba(243, 115, 33, 0.14);
            color: var(--accent);
        }

        .image-pair {
            display: grid;
            gap: 10px;
            grid-template-columns: 1fr;
        }

        .image-pair.split { grid-template-columns: 1fr 1fr; }

        /* Snapshot card stretches to match the live-video column height. */
        .snapshot-card {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
        }

        .snapshot-card .image-pair {
            flex: 1;
            min-height: 0;
        }

        .snapshot-card .image-cell { height: 100%; }

        .snapshot-card .image-cell img {
            height: 100%;
            min-height: 0;
        }

        .image-cell {
            position: relative;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: #02060a;
            border: 1px solid rgba(255, 255, 255, 0.06);
            cursor: zoom-in;
        }

        .image-cell img {
            display: block;
            width: 100%;
            min-height: 180px;
            object-fit: contain;
            background: #02060a;
        }

        .image-cell.hidden { display: none; }

        .image-tag {
            position: absolute;
            top: 8px;
            left: 8px;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.10em;
            background: rgba(8, 12, 17, 0.72);
            color: var(--accent);
            border: 1px solid rgba(243, 115, 33, 0.30);
            backdrop-filter: blur(6px);
        }

        .image-tag.analysis { color: #b5ffdf; border-color: rgba(46, 207, 141, 0.32); }

        .object-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 160px;
            overflow-y: auto;
        }

        .object-chip {
            padding: 6px 10px;
            border-radius: 999px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            font-size: 11px;
            color: var(--text-2);
        }

        .object-chip.person { background: rgba(243, 115, 33, 0.12); border-color: rgba(243, 115, 33, 0.28); color: #d6f3ff; }
        .object-chip.vehicle { background: rgba(255, 176, 86, 0.12); border-color: rgba(255, 176, 86, 0.30); color: #ffd3bf; }

        .result-meta {
            margin-top: 10px;
            font-size: 12px;
            color: var(--muted);
            line-height: 1.6;
            word-break: break-all;
        }

        .result-meta .accent { color: var(--accent); font-weight: 700; }

        /* ============ Events ============ */
        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 12px;
            max-height: 460px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .events-grid::-webkit-scrollbar { width: 8px; }
        .events-grid::-webkit-scrollbar-thumb { background: rgba(20, 28, 40, 0.18); border-radius: 999px; }

        .event-card {
            border-radius: var(--radius-md);
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            overflow: hidden;
            transition: transform 0.16s ease, border-color 0.16s ease;
        }

        .event-card:hover {
            transform: translateY(-2px);
            border-color: rgba(243, 115, 33, 0.28);
        }

        .event-card img {
            display: block;
            width: 100%;
            height: 130px;
            object-fit: cover;
            cursor: zoom-in;
        }

        .event-card-body { padding: 10px 12px 12px; }

        .event-card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
        }

        .event-risk {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.10em;
            padding: 2px 8px;
            border-radius: 999px;
        }

        .event-frame { font-size: 11px; color: var(--muted); }
        .event-info { font-size: 11px; color: var(--muted); line-height: 1.55; word-break: break-all; }
        .event-info b { color: var(--text-2); font-weight: 600; }

        .empty {
            grid-column: 1 / -1;
            color: var(--muted);
            font-size: 13px;
            text-align: center;
            padding: 28px 0;
        }

        /* ============ Modal ============ */
        .modal {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 28px;
            background: rgba(20, 28, 40, 0.42);
            z-index: 100;
            backdrop-filter: blur(6px);
        }

        .modal.open { display: flex; }

        .modal-card {
            width: min(1200px, 100%);
            max-height: calc(100vh - 56px);
            padding: 18px;
            border-radius: 22px;
            background: var(--bg-card);
            border: 1px solid var(--border-strong);
            box-shadow: 0 30px 80px rgba(20, 28, 40, 0.28);
            display: flex;
            flex-direction: column;
        }

        .modal-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .modal-title { font-size: 15px; font-weight: 700; }

        .modal-stage {
            position: relative;
            flex: 1;
            min-height: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 14px;
            background: #02060a;
        }

        .modal-image {
            display: block;
            max-width: 100%;
            max-height: calc(100vh - 200px);
            object-fit: contain;
            transform: translate(0, 0) scale(1);
            transition: transform 0.10s ease-out;
            cursor: zoom-in;
            user-select: none;
            -webkit-user-drag: none;
        }
        .modal-stage.zoomed .modal-image { cursor: grab; }
        .modal-stage.panning .modal-image { cursor: grabbing; transition: none; }

        .nav-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: rgba(20, 28, 40, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(6px);
        }
        .nav-arrow.prev { left: 14px; }
        .nav-arrow.next { right: 14px; }
        .nav-arrow:hover:not(:disabled) { background: var(--brand); border-color: var(--brand); transform: translateY(-50%); }
        .nav-arrow:disabled, .nav-arrow.hidden { opacity: 0; pointer-events: none; }

        .modal-head-actions { display: inline-flex; align-items: center; gap: 8px; }
        .modal-counter { font-size: 12px; color: var(--muted); min-width: 44px; text-align: right; }
        .modal-head-actions .btn-ghost { padding: 7px 10px; min-width: 34px; }

        .modal-caption {
            margin-top: 12px;
            color: var(--muted);
            font-size: 12px;
            word-break: break-all;
        }

        /* ============ Settings ============ */
        .settings-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-2);
            background: var(--bg-soft);
            border: 1px solid var(--border-soft);
            cursor: pointer;
            transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
        }
        .settings-btn:hover { color: var(--text); border-color: var(--border-strong); background: var(--bg-softer); }
        .settings-btn svg { transition: transform 0.4s ease; }
        .settings-btn:hover svg { transform: rotate(60deg); }

        .modal-card.settings-card { width: min(620px, 100%); }

        .modal-body {
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 18px;
            padding-right: 4px;
        }

        .settings-group {
            border: 1px solid var(--border-soft);
            border-radius: 14px;
            padding: 14px 16px;
            background: var(--bg-soft);
        }
        .settings-group-title {
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            font-weight: 700;
            margin-bottom: 12px;
        }

        .setting-row {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 12px;
            padding: 9px 0;
            border-top: 1px solid var(--border-soft);
        }
        .settings-group .setting-row:first-of-type { border-top: none; }
        .setting-label { font-size: 13px; font-weight: 600; color: var(--text); }
        .setting-desc { font-size: 11px; color: var(--muted); margin-top: 2px; max-width: 360px; }

        .setting-control { display: flex; align-items: center; gap: 10px; justify-self: end; }
        .setting-control input[type="range"] { width: 150px; accent-color: var(--accent); }
        .setting-control input[type="number"] {
            width: 74px;
            padding: 6px 8px;
            border-radius: 8px;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            color: var(--text);
            font-size: 13px;
            font-variant-numeric: tabular-nums;
            text-align: right;
        }
        .setting-val {
            min-width: 42px;
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-weight: 700;
            color: var(--accent);
            font-size: 13px;
        }

        /* toggle switch */
        .switch { position: relative; width: 44px; height: 24px; flex: none; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .switch .slider {
            position: absolute; inset: 0; cursor: pointer;
            background: var(--bg-softer);
            border: 1px solid var(--border-soft);
            border-radius: 999px;
            transition: background 0.2s ease, border-color 0.2s ease;
        }
        .switch .slider::before {
            content: ""; position: absolute;
            height: 16px; width: 16px; left: 3px; top: 3px;
            background: var(--muted);
            border-radius: 50%;
            transition: transform 0.2s ease, background 0.2s ease;
        }
        .switch input:checked + .slider { background: rgba(46, 207, 141, 0.30); border-color: rgba(46, 207, 141, 0.5); }
        .switch input:checked + .slider::before { transform: translateX(20px); background: var(--accent); }

        .modal-foot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 16px;
            padding-top: 14px;
            border-top: 1px solid var(--border-soft);
        }
        .modal-foot .foot-note { font-size: 11px; color: var(--muted); }
        .modal-foot .foot-actions { display: flex; gap: 10px; }

        /* ============ Toasts ============ */
        .toast-stack {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 200;
            max-width: 360px;
            pointer-events: none;
        }

        .toast {
            display: grid;
            grid-template-columns: 4px 1fr;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #f4f6f9;
            border: 1px solid var(--border);
            box-shadow: 0 14px 32px rgba(20, 28, 40, 0.18);
            animation: toast-in 0.24s cubic-bezier(0.2, 0.8, 0.3, 1.2);
            backdrop-filter: blur(8px);
            pointer-events: auto;
        }

        @keyframes toast-in {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .toast .toast-bar { border-radius: 999px; background: var(--accent); }
        .toast.notice .toast-bar { background: var(--notice); }
        .toast.warning .toast-bar { background: var(--warn); }
        .toast.critical .toast-bar { background: var(--danger); }

        .toast-title { font-size: 13px; font-weight: 700; }
        .toast-body { font-size: 11px; color: var(--muted); margin-top: 3px; line-height: 1.5; }

        /* ============ Responsive ============ */
        @media (max-width: 1280px) {
            .kpi-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
            .ops-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 980px) {
            .shell { grid-template-columns: 1fr; grid-template-rows: 64px auto 1fr; }
            .sidebar { display: none; }
            .status-cluster { display: none; }
            .kpi-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        /* ============ Premium pass: numbers, focus, scrollbar, states ============ */

        /* Tabular figures so live metrics don't jitter as digits change. */
        body { font-variant-numeric: tabular-nums; }

        /* Smooth, consistent interaction feedback. */
        .card, .kpi-card, .nav-item, .tab, .led-pill, .btn-ghost {
            transition: background 0.16s ease, border-color 0.16s ease,
                        color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
        }

        /* Keyboard accessibility — a single branded focus ring. */
        a:focus-visible, button:focus-visible, select:focus-visible,
        input:focus-visible, [tabindex]:focus-visible {
            outline: none;
            box-shadow: var(--ring);
            border-radius: var(--radius-sm);
        }

        /* Elevation discipline: a quiet lift on hover for clickable cards. */
        .nav-item:hover { transform: translateX(2px); }

        /* Custom scrollbars — keeps the dark theme consistent. */
        * { scrollbar-width: thin; scrollbar-color: rgba(160,170,184,0.28) transparent; }
        *::-webkit-scrollbar { width: 10px; height: 10px; }
        *::-webkit-scrollbar-track { background: transparent; }
        *::-webkit-scrollbar-thumb {
            background: rgba(160, 170, 184, 0.22);
            border-radius: 999px;
            border: 2px solid transparent;
            background-clip: padding-box;
        }
        *::-webkit-scrollbar-thumb:hover { background: rgba(160, 170, 184, 0.38); background-clip: padding-box; }

        /* Skeleton shimmer for loading placeholders. */
        @keyframes shimmer { 0% { background-position: -160% 0; } 100% { background-position: 160% 0; } }
        .skeleton {
            background: linear-gradient(100deg,
                rgba(255,255,255,0.03) 30%,
                rgba(255,255,255,0.09) 50%,
                rgba(255,255,255,0.03) 70%);
            background-size: 200% 100%;
            animation: shimmer 1.4s ease-in-out infinite;
            border-radius: var(--radius-sm);
        }

        /* Snapshot cells shimmer while waiting for the first analyzed frame. */
        .image-pair.is-waiting .image-cell {
            background: #02060a linear-gradient(100deg,
                rgba(255,255,255,0.03) 30%,
                rgba(255,255,255,0.10) 50%,
                rgba(255,255,255,0.03) 70%);
            background-size: 200% 100%;
            animation: shimmer 1.4s ease-in-out infinite;
        }
        .image-pair.is-waiting .image-cell::after {
            content: '스냅샷 대기 중…';
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            color: rgba(236, 242, 248, 0.7);
            font-size: var(--text-xs);
            letter-spacing: 0.12em;
        }

        /* Richer empty state. */
        .empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 32px 16px;
            color: var(--muted);
            font-size: var(--text-sm);
            text-align: center;
        }
        .empty::before {
            content: '';
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 2px dashed rgba(160, 170, 184, 0.32);
            opacity: 0.8;
        }

        /* Subtle Hanwha brand watermark on the idle live viewer. */
        .viewer-stage::after {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 50% 46%, rgba(243, 115, 33, 0.06), transparent 42%);
            opacity: 1;
            transition: opacity 0.3s ease;
        }
        .viewer-stage.has-media::after { opacity: 0; }

        /* Inline engine-error banner (shown when the AI engine fails to load). */
        .engine-banner {
            display: none;
            align-items: center;
            gap: 10px;
            margin: 0 0 14px;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            background: rgba(255, 90, 95, 0.12);
            border: 1px solid rgba(255, 90, 95, 0.40);
            color: var(--on-danger);
            font-size: var(--text-sm);
        }
        .engine-banner.show { display: flex; }
        .engine-banner .dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--danger); flex: none;
            box-shadow: 0 0 0 4px rgba(255, 90, 95, 0.18);
        }

        /* Engine-preparation progress bar (shown while the model loads, ~20s). */
        .engine-prep {
            display: none;
            margin: 0 0 14px;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            background: rgba(74, 158, 255, 0.10);
            border: 1px solid rgba(74, 158, 255, 0.32);
        }
        .engine-prep.show { display: block; }
        .engine-prep-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 9px;
            font-size: var(--text-sm);
            color: var(--text-1, #d6e4f0);
        }
        .engine-prep-head .label { display: flex; align-items: center; gap: 9px; }
        .engine-prep-head .spinner {
            width: 13px; height: 13px; flex: none;
            border: 2px solid rgba(74, 158, 255, 0.30);
            border-top-color: #4a9eff;
            border-radius: 50%;
            animation: enginePrepSpin 0.8s linear infinite;
        }
        .engine-prep-head .pct { font-variant-numeric: tabular-nums; opacity: 0.85; }
        .engine-prep-track {
            height: 6px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            overflow: hidden;
        }
        .engine-prep-fill {
            height: 100%;
            width: 0%;
            border-radius: 999px;
            background: linear-gradient(90deg, #3a7bd5, #4a9eff);
            transition: width 0.3s ease;
        }
        @keyframes enginePrepSpin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="shell">
        <!-- ============ TOP BAR ============ -->
        <header class="topbar">
            <div class="brand">
                <div class="brand-logo">
                    <img src="Resources/hanwha.ico" alt="Hanwha" class="brand-logo-img" />
                </div>
                <div>
                    <div class="brand-name">Hanwha</div>
                    <div class="brand-sub">Drone Detection System</div>
                </div>
            </div>

            <button id="settingsBtn" class="settings-btn" title="감지/분석 설정" style="margin-left:auto;">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                설정
            </button>
        </header>

        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar">
            <div>
                <div class="nav-group-label">Operations</div>
                <button class="nav-item active" data-view="dashboard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                    대시보드
                </button>
                <button class="nav-item" data-view="live">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg>
                    실시간 관제
                </button>
                <button class="nav-item" data-view="events">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/></svg>
                    이벤트 아카이브
                    <span class="nav-tag" id="navEventsCount">0</span>
                </button>
            </div>

            <div>
                <div class="nav-group-label">System</div>
                <button class="nav-item" data-action="settings">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    설정
                </button>
            </div>

            <div class="sidebar-foot" style="margin-top: auto;">v0.9.0 · Local Build</div>
        </aside>

        <!-- ============ CONTENT ============ -->
        <main class="content">
            <div id="engineBanner" class="engine-banner">
                <span class="dot"></span>
                <span id="engineBannerText">AI 엔진 연결에 문제가 발생했습니다.</span>
            </div>
            <div id="enginePrep" class="engine-prep">
                <div class="engine-prep-head">
                    <span class="label"><span class="spinner"></span><span id="enginePrepText">AI 모델을 준비하고 있습니다… (최초 실행 시 다운로드로 더 걸릴 수 있습니다)</span></span>
                    <span class="pct" id="enginePrepPct">0%</span>
                </div>
                <div class="engine-prep-track"><div class="engine-prep-fill" id="enginePrepFill"></div></div>
            </div>

            <!-- ============ VIEW HEADER ============ -->
            <div class="view-header">
                <div>
                    <div class="view-title" id="viewTitle">대시보드</div>
                    <div class="view-desc" id="viewDesc">현장 관제 시스템 개요</div>
                </div>
                <div class="view-header-meta">
                    <span><span class="led"></span>System Online</span>
                    <span class="view-clock" id="viewClock">--:--:--</span>
                </div>
            </div>

            <!-- ============ VIEW: DASHBOARD ============ -->
            <div class="view active" data-view-panel="dashboard">
                <section class="dash-hero">
                    <div class="dash-hero-main card">
                        <div class="dash-hero-eyebrow">현재 현장 위험도</div>
                        <div class="dash-risk-big risk-clear" data-mirror-risk="riskBadge">CLEAR</div>
                        <div class="dash-hero-sub" data-mirror="missionState">대기 중</div>
                    </div>
                    <div class="dash-hero-side card">
                        <div class="dash-line"><span>AI 엔진</span><b data-mirror="engineStatus">Engine</b></div>
                        <div class="dash-line"><span>실행 디바이스</span><b data-mirror="deviceBadge">Device · —</b></div>
                        <div class="dash-line"><span>분석 프로필</span><b data-mirror="profileMeta">balanced</b></div>
                        <div class="dash-line"><span>선택 영상</span><b data-mirror="selectedVideo">없음</b></div>
                    </div>
                </section>

                <section class="dash-kpis">
                    <div class="kpi-card accent"><div class="kpi-label">현재 사람</div><div class="kpi-value" data-mirror="currentPersons">0</div><div class="kpi-foot">PERSON · live</div></div>
                    <div class="kpi-card warn"><div class="kpi-label">현재 차량</div><div class="kpi-value" data-mirror="currentVehicles">0</div><div class="kpi-foot">VEHICLE · live</div></div>
                    <div class="kpi-card"><div class="kpi-label">저장 이벤트</div><div class="kpi-value" data-mirror="eventCount">0</div><div class="kpi-foot">SAVED</div></div>
                    <div class="kpi-card"><div class="kpi-label">분석 완료</div><div class="kpi-value small" data-mirror="analysisCount">0</div><div class="kpi-foot">ANALYZED</div></div>
                    <div class="kpi-card"><div class="kpi-label">원본 FPS</div><div class="kpi-value small" data-mirror="streamFps">0.0</div><div class="kpi-foot">STREAM</div></div>
                    <div class="kpi-card"><div class="kpi-label">추론 FPS</div><div class="kpi-value small" data-mirror="inferenceFps">0.0</div><div class="kpi-foot">INFERENCE</div></div>
                </section>

                <section class="card dash-actions">
                    <div>
                        <div class="card-title">빠른 실행</div>
                        <div class="card-sub">실시간 관제 화면으로 이동하거나 저장된 이벤트를 확인하세요.</div>
                    </div>
                    <div class="dash-actions-btns">
                        <button class="btn-primary" data-goto-view="live">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            실시간 관제 시작
                        </button>
                        <button class="btn-ghost" data-goto-view="events">이벤트 아카이브</button>
                        <button class="btn-ghost" data-action="settings">감지 설정</button>
                    </div>
                </section>
            </div>

            <!-- ============ VIEW: LIVE ============ -->
            <div class="view" data-view-panel="live">
            <!-- Mission Bar -->
            <section id="liveSection" class="mission-bar" style="grid-template-columns: 1fr; gap: 0;">
                <div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center;">
                    <div class="mission-info">
                        <div class="mission-row">
                            <div id="missionState" class="mission-state idle"><span class="led"></span>대기 중</div>
                            <div id="streamInfo" class="tag">stream idle</div>
                            <div id="runModeTag" class="tag">수동 모드</div>
                            <div id="engineStatus" class="led-pill"><span class="led"></span>Engine</div>
                            <div id="deviceBadge" class="led-pill">Device · —</div>
                            <div id="riskBadge" class="led-pill risk-badge risk-clear">CLEAR</div>
                        </div>
                        <div class="mission-meta">
                            <span>선택 영상<b id="selectedVideo">없음</b></span>
                            <span>샘플링<b id="samplingMeta">3초</b></span>
                            <span>프로필<b id="profileMeta">balanced</b></span>
                        </div>
                    </div>
                    <div class="mission-controls">
                        <div class="mode-toggle" id="modeToggle" title="사진: 단일 이미지 분석 / 수동: 직접 선택 / 자동: 폴더 감시 / 스트림: 스트리밍 주소 분석">
                            <button class="mode-opt" data-mode="photo">사진 분석</button>
                            <button class="mode-opt active" data-mode="manual">수동</button>
                            <button class="mode-opt" data-mode="auto">자동</button>
                            <button class="mode-opt" data-mode="stream">스트림</button>
                        </div>
                        <div class="ctl-group">
                            <label for="intervalRange">분석 간격</label>
                            <input type="range" id="intervalRange" min="1" max="10" value="3" />
                            <span class="ctl-value" id="intervalValue">3s</span>
                        </div>
                        <div class="ctl-group">
                            <label for="profileSelect">프로필</label>
                            <select id="profileSelect">
                                <option value="fast">fast</option>
                                <option value="balanced" selected>balanced</option>
                                <option value="accurate">accurate</option>
                            </select>
                        </div>
                        <button id="analyzeBtn" class="btn-primary" disabled>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            드론 영상 선택 후 분석 시작
                        </button>
                        <button id="stopBtn" class="btn-danger" disabled>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
                            분석 중지
                        </button>
                    </div>
                </div>
                <div class="watch-row" id="watchRow">
                    <span class="watch-status-dot" id="watchStatusDot"></span>
                    <span style="font-weight: 600;">감시 폴더</span>
                    <span class="watch-folder-path empty" id="watchFolderPath">선택되지 않음</span>
                    <button id="selectFolderBtn" class="btn-ghost">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        찾아보기
                    </button>
                    <span class="queue-badge" id="queueBadge">대기열 0</span>
                    <span class="watch-last" id="lastDetected">최근 감지: —</span>
                </div>
                <div class="watch-row" id="streamRow">
                    <span class="watch-status-dot" id="streamStatusDot"></span>
                    <span style="font-weight: 600;">스트림 주소</span>
                    <input type="text" id="streamUrlInput" class="stream-url-input" spellcheck="false"
                           placeholder="rtsp://… 또는 http://… 스트리밍 주소를 입력하세요" />
                    <span class="watch-last" id="streamHint">시작을 누르면 실시간 드론 영상에 스트리밍되며 분석이 시작됩니다.</span>
                </div>
            </section>

            <!-- KPI Strip -->
            <section class="kpi-strip">
                <div class="kpi-card accent">
                    <div class="kpi-label">현재 사람</div>
                    <div class="kpi-value" id="currentPersons">0</div>
                    <div class="kpi-foot">PERSON · live</div>
                </div>
                <div class="kpi-card warn">
                    <div class="kpi-label">현재 차량</div>
                    <div class="kpi-value" id="currentVehicles">0</div>
                    <div class="kpi-foot">VEHICLE · live</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">이벤트</div>
                    <div class="kpi-value" id="eventCount">0</div>
                    <div class="kpi-foot">SAVED</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">스냅샷</div>
                    <div class="kpi-value small" id="snapshotCount">0</div>
                    <div class="kpi-foot">SAMPLES</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">분석 완료</div>
                    <div class="kpi-value small" id="analysisCount">0</div>
                    <div class="kpi-foot">ANALYZED</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">원본 FPS</div>
                    <div class="kpi-value small" id="streamFps">0.0</div>
                    <div class="kpi-foot">STREAM</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">추론 FPS</div>
                    <div class="kpi-value small" id="inferenceFps">0.0</div>
                    <div class="kpi-foot">INFERENCE</div>
                </div>
            </section>

            <!-- Ops Grid -->
            <section class="ops-grid">
                <!-- Left column -->
                <div style="display: flex; flex-direction: column; gap: 16px; min-width: 0;">
                    <div class="card viewer-card">
                        <div class="card-head">
                            <div>
                                <div class="card-title">
                                    <span id="recDot" class="rec-dot idle"></span>
                                    실시간 드론 영상
                                </div>
                                <div class="card-sub" id="statusLine">Python 엔진과 모델을 준비하고 있습니다.</div>
                            </div>
                            <div class="card-tags">
                                <span class="tag" id="frameTag">frame · 0 / 0</span>
                            </div>
                        </div>
                        <div class="viewer-stage">
                            <video id="liveVideo" muted playsinline preload="auto"></video>
                            <img id="liveStreamImg" alt="실시간 스트림" style="display: none;" />
                            <div class="hud-corner-tl"></div>
                            <div class="hud-corner-tr"></div>
                            <div class="hud-corner-bl"></div>
                            <div class="hud-corner-br"></div>
                            <div class="viewer-hud">
                                <div class="hud-row">
                                    <div id="hudRisk" class="hud-risk-banner risk-clear">CLEAR</div>
                                    <div class="hud-pill" id="hudTime">⏱ 0.0s</div>
                                </div>
                                <div class="hud-row">
                                    <div class="hud-pill" id="hudCounts">👤 0 · 🚗 0</div>
                                    <div class="hud-pill" id="hudFps">⚡ 0.0 fps</div>
                                </div>
                            </div>
                        </div>
                        <div class="progress-row">
                            <button id="pauseBtn" class="pause-btn" disabled title="일시정지 / 재개">
                                <svg class="ic-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                                <svg class="ic-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><polygon points="7 4 19 12 7 20 7 4"/></svg>
                            </button>
                            <button id="captureBtn" class="pause-btn" disabled title="현재 프레임 캡처 후 분석 (일시정지 중)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            </button>
                            <div class="progress-label" id="progressText">대기 중</div>
                            <div class="progress-bar" id="progressBar" title="클릭하거나 드래그해 분석 위치를 이동합니다">
                                <div id="progressFill" class="progress-fill"></div>
                                <div id="progressKnob" class="progress-knob"></div>
                            </div>
                            <div class="progress-percent" id="progressPercent">0%</div>
                        </div>
                        <div class="status-line" id="riskSummary">현재 감지된 사람이나 차량이 없습니다.</div>
                    </div>
                </div>

                <!-- Right rail -->
                <aside class="rail">
                    <div class="card snapshot-card">
                        <div class="card-head">
                            <div>
                                <div class="card-title">캡처 스냅샷</div>
                                <div class="card-sub" id="snapshotTimestamp">아직 캡처된 스냅샷이 없습니다.</div>
                            </div>
                            <div class="snapshot-head-actions">
                                <button id="loadImageBtn" class="btn-ghost" style="display:none;" title="이미지를 불러와 즉시 분석합니다">불러오기</button>
                                <div class="tab-group" id="snapshotTabs">
                                    <button class="tab" data-view="raw">원본</button>
                                    <button class="tab" data-view="annotated">분석</button>
                                    <button class="tab active" data-view="split">분할</button>
                                </div>
                            </div>
                        </div>
                        <div id="imagePair" class="image-pair split">
                            <div class="image-cell" data-cell="raw">
                                <img id="snapshotImage" alt="원본 스냅샷" />
                                <div class="image-tag">RAW</div>
                            </div>
